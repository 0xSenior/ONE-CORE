# Dependency directories
node_modules/
jspm_packages/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Sensitive data)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local databases (Lowdb files)
